{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praat.example/schemas/vot-gold-manifest-v1.json",
  "title": "Human-adjudicated Japanese VOT gold set",
  "type": "object",
  "required": ["schema_version", "language", "annotation_protocol", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "language": {"const": "ja"},
    "annotation_protocol": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "boundaryPair": {
      "type": "object",
      "required": ["burst_sample_index", "onset_sample_index"],
      "properties": {
        "burst_sample_index": {"type": "integer", "minimum": 0},
        "onset_sample_index": {"type": "integer", "minimum": 0},
        "uncertainty_samples": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id", "audio", "audio_sha256", "language", "sample_rate_hz", "sample_count",
        "target_selection_samples", "transcript", "phonemes", "target_phone_index",
        "mode", "vot_class", "annotators", "adjudicated", "flags"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "audio": {"type": "string", "minLength": 1},
        "audio_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "language": {"const": "ja"},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "target_selection_samples": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "integer", "minimum": 0}
        },
        "context_start_sample": {"type": "integer", "minimum": 0},
        "context_end_sample": {"type": "integer", "minimum": 1},
        "transcript": {"type": "string"},
        "phonemes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "target_phone_index": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["model_assisted", "acoustic_only"]},
        "parameters": {"type": "object"},
        "vot_class": {"enum": ["positive", "zero", "negative"]},
        "annotators": {
          "type": "object", "minProperties": 2,
          "additionalProperties": {"$ref": "#/$defs/boundaryPair"}
        },
        "adjudicated": {
          "allOf": [
            {"$ref": "#/$defs/boundaryPair"},
            {"type": "object", "required": ["uncertainty_samples"]}
          ]
        },
        "alternative_pairs": {
          "type": "array", "items": {"$ref": "#/$defs/boundaryPair"}
        },
        "flags": {
          "type": "object",
          "required": ["multiple_burst_candidates", "sustained_voicing", "ambiguous_evidence"],
          "properties": {
            "multiple_burst_candidates": {"type": "boolean"},
            "sustained_voicing": {"type": "boolean"},
            "ambiguous_evidence": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
