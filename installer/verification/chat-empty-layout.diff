--- before/styles.css
+++ ai/frontend/src/styles.css
@@ -27,6 +27,16 @@
 html[data-pane-resizing=true] .sidebar{transition:none}
 .thread{--conversation-band:min(100%,var(--conversation-width,850px))}
 .transcript-shell{flex:1;min-height:0;position:relative;display:flex;flex-direction:column}
+/* Codex startup_draft_layout.rs keeps first-screen decoration in the remaining
+   area, outside scrollback. The welcome screen likewise overlays the empty
+   viewport; only actual messages contribute transcript height. */
+.transcript-shell{container-type:size}
+.transcript-content:empty{padding:0}
+.transcript-shell>.welcome{position:absolute;inset:0;min-height:0;height:auto;overflow:clip;padding:clamp(8px,5cqh,40px) 18px}
+@container(max-height:320px){.welcome .welcome-mark{width:48px;height:48px;margin-bottom:8px;flex-shrink:0}.welcome h2{margin:4px 0}.welcome p{margin:6px 0}.welcome .welcome-cards{margin:10px 0 0}}
+@container(max-height:240px){.welcome .welcome-mark{display:none}}
+@container(max-height:180px){.welcome p{display:none}}
+@container(max-height:100px){.welcome .welcome-cards{display:none}.welcome h2{font-size:16px}}
 .transcript-content{max-width:var(--conversation-band)}
 .composer{max-width:var(--conversation-band)}
 .chat-width-handles{position:absolute;inset:0;display:flex;justify-content:center;pointer-events:none;z-index:3}
